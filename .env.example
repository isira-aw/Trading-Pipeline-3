# Infra secrets only — set once at install time (§1.2).
# Everything operational (symbols, thresholds, stage, schedule, LLM provider
# and model names) is edited from the dashboard and stored in the `config`
# DB table instead — see app/config_defaults.py and PUT /api/config/{key}.
# That table is read fresh on every request, so a change there takes effect
# immediately with no restart.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# IMPORTANT: this file is loaded once, at process start (Python does not
# hot-reload environment variables or .env files). Any edit here — a new
# API key, a changed URL — has no effect on an already-running backend.
# You must restart the backend process for the change to take effect.
# `GET /api/status` warns in its response if `.env` was modified more
# recently than the running process started, specifically to catch this.

# Binance API. Create the key with WITHDRAWAL PERMISSION DISABLED (§10).
# Leave blank to run data-download and training only — public market data
# needs no credentials.
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trading_pipeline
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/trading_pipeline

# LLM advisor (§5.1). Ollama is the default; Gemini is the fallback.
OLLAMA_BASE_URL=http://host.docker.internal:11434
GEMINI_API_KEY=your_gemini_api_key_if_used
